{
  "name": "Stripe 429 rate_limit_error (payment_method=pm_error_429)",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/payment_intents",
    "bodyPatterns": [{ "contains": "payment_method=pm_error_429" }]
  },
  "response": {
    "status": 429,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": {
